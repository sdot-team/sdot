{
 "format": 1,
 "package": {
  "name": "sdot",
  "pip": "sdot",
  "index": "https://pypi.org/simple"
 },
 "services": {
  "blender": {
   "protocol": 1,
   "text": "Pictures of the current view by Blender ( Cycles, on the GPU when there is one ).",
   "version_of": [
    "blender.py",
    "../store.py"
   ],
   "run": [
    "{tool:blender}",
    "-b",
    "--factory-startup",
    "-P",
    "{file:blender.py}",
    "--",
    "--port",
    "{port}"
   ],
   "needs": {
    "gpus": 1,
    "gpu_kind": "any"
   },
   "idle": "10m",
   "tools": {
    "blender": {
     "min": "5.0",
     "look": {
      "macos-*": [
       "/Applications/Blender.app/Contents/MacOS/Blender"
      ],
      "*": [
       "blender"
      ]
     },
     "version_from": [
      {
       "plist": "../Info.plist",
       "key": "CFBundleShortVersionString"
      },
      {
       "dirname": "blender-(\\d+\\.\\d+\\.\\d+)"
      },
      {
       "dpkg": "blender"
      },
      {
       "snap": "blender"
      }
     ],
     "fetch": {
      "macos-arm64": {
       "url": "https://download.blender.org/release/Blender5.2/blender-5.2.2-macos-arm64.dmg",
       "sha256": "dc4125399b8bfefe283cc1624d6cfc7809d1cac20ace51072127eb371f31f210",
       "run": "Blender.app/Contents/MacOS/Blender",
       "version": "5.2.2"
      },
      "linux-x86_64": {
       "url": "https://download.blender.org/release/Blender5.2/blender-5.2.2-linux-x64.tar.xz",
       "sha256": "84098912789dc450e95697c4184fb8a90acbe5111c2ba4aede3fecb57806a168",
       "run": "blender-5.2.2-linux-x64/blender",
       "version": "5.2.2"
      },
      "windows-x86_64": {
       "url": "https://download.blender.org/release/Blender5.2/blender-5.2.2-windows-x64.zip",
       "sha256": "3849d17a682cba006075aaa3f3597ecb5c9c30ec31035b2e092c53e40679b535",
       "run": "blender-5.2.2-windows-x64/blender.exe",
       "version": "5.2.2"
      },
      "windows-arm64": {
       "url": "https://download.blender.org/release/Blender5.2/blender-5.2.2-windows-arm64.zip",
       "sha256": "2e90b53c9443cc56d2be75a61550a38e4aba942c8cded046ceff98ed58ebc67b",
       "run": "blender-5.2.2-windows-arm64/blender.exe",
       "version": "5.2.2"
      }
     }
    }
   }
  },
  "sdot.region": {
   "protocol": 1,
   "text": "Rebuilds the cells of a region ( a cut, the boundary ) from the frame's seeds ( sdot, CPU ).",
   "version_of": [
    "region.py",
    "../store.py"
   ],
   "run": [
    "{python}",
    "-m",
    "sdot.viz.services.region",
    "--port",
    "{port}"
   ],
   "idle": "10m"
  },
  "sdot.ao": {
   "protocol": 1,
   "text": "Bakes the ambient occlusion of the faces of the frame shown ( sdot, CPU ).",
   "version_of": [
    "ao.py",
    "../occlusion.py",
    "../store.py"
   ],
   "run": [
    "{python}",
    "-m",
    "sdot.viz.services.ao",
    "--port",
    "{port}"
   ],
   "idle": "10m"
  }
 }
}
