# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/


# build outputs
prototypes/
build/
*.o
*.a
*.so
*.so.p
*.dylib
compile_commands.json
catalogue_record
grill/

# THE PRECOMPILED KERNELS: `<tag>/<key>.so` per architecture, produced by `make catalogue` ( tagged CACHEDIR.TAG by loom )
src/sdot/kernel-catalogue/
# the name they had before 2026-11-19
src/sdot/precompiled-kernels/

# the runner ( errand )
errand-outputs/
runs/

# misc
tmp/
.cache/
bench/cases/
.DS_Store

# the docs site ( vitepress ): keep its config and theme, not its dependencies nor its builds
node_modules/
docs/.vitepress/cache/
docs/.vitepress/dist/
.pytest_cache/

# the wheels `make wheels` ( loom.release ) builds
/dist/

# what only this machine knows ( hosts, paths ): see errand-envs.py
errand-vars.py
*.sif

# what loom.release writes for the build environments ( their recipes, the images built from them )
/.loom/
# where loom builds the wheels: names this machine's hosts
/loom-builders.py
