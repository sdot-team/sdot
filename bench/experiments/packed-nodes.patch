+#: the doubles of a packed node ( `AaBsp.node_pack` ): one 64-byte line
+PACK_WIDTH = 8
+
+
+def _packed_nodes( node_box, node_begin, node_end ):
+    """`AaBsp.node_pack`: per node, its box ( `lo` then `hi` ) then `begin` and `end` as doubles, padded to `PACK_WIDTH`"""
+    box = np.asarray( node_box, dtype = np.float64 )
+    nb_nodes = box.shape[ 0 ]
+    # on a 64-byte boundary, or a record straddles two lines ( a large `np.zeros` is page-aligned plus a header )
+    buf = np.zeros( nb_nodes * PACK_WIDTH + PACK_WIDTH )
+    off = ( -buf.ctypes.data % 64 ) // 8
+    res = buf[ off: off + nb_nodes * PACK_WIDTH ].reshape( nb_nodes, PACK_WIDTH )
+    res[ :, :box[ 0 ].size ] = box.reshape( nb_nodes, -1 )
+    res[ :, box[ 0 ].size ] = np.asarray( node_begin ).reshape( -1 )
+    res[ :, box[ 0 ].size + 1 ] = np.asarray( node_end ).reshape( -1 )
+    return res
+
